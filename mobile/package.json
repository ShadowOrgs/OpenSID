{
  "name": "opensid-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "dev:setup": "bash ../scripts/dev-setup.sh",
    "dev:opensid": "bash ../scripts/dev-mobile.sh",
    "dev:opensid:usb": "bash ../scripts/dev-mobile.sh --usb",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:dev:local": "eas build --platform android --profile development --local",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:preview:local": "eas build --platform android --profile preview --local",
    "build:android:aab": "eas build --platform android --profile production",
    "build:android:aab:local": "eas build --platform android --profile production --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@tanstack/react-query": "^5.59.16",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.53.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "^0.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/plugin-transform-private-property-in-object": "^8.0.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^57.0.2",
    "eas-cli": "^20.1.0",
    "typescript": "~5.9.2"
  }
}
