{
  "expo": {
    "name": "OpenSID Mandiri",
    "slug": "opensid-mandiri",
    "scheme": "opensidmandiri",
    "icon": "./assets/logo-desa.png",
    "web": {
      "favicon": "./assets/logo-desa.png"
    },
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "id.opensid.mandiri",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0b8fac"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Aplikasi membutuhkan akses galeri untuk menyimpan gambar.",
          "savePhotosPermission": "Aplikasi membutuhkan izin untuk menyimpan gambar ke galeri."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "142a3c8e-3870-4039-b7e7-dd0b57fb19ec"
      }
    }
  }
}
